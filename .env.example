# Discord
TOKEN=""
APP_ID=
GUILD_ID=
# Support-server channel for full-map schedule requests (optional; see
# specs/premium-full-map.md). Unset => command-only review.
REQUESTS_CHANNEL_ID=
# Everyone allowed to approve/deny those requests. This is the COMPLETE list:
# the application's owner is NOT added automatically, so put your own id in it.
#
# One id on its own:
#   REVIEWER_IDS=123456789012345678
# Several, comma-separated (spaces around the commas are fine):
#   REVIEWER_IDS=123456789012345678,987654321098765432
#
# The id is a Discord user id, not a username: turn on Developer Mode in
# Discord (Settings -> Advanced), then right-click your name -> Copy User ID.
#
# Left empty, nobody can review requests and the bot says so at startup. It
# lives here rather than in the database because reviewers read other servers'
# form answers, so the list belongs to whoever runs the host.
REVIEWER_IDS=

# Logging (see specs/architecture.md -> Logging). All optional.
#
# Where the log files go. Two files per day: foxholewarbot.<date>.log, which is
# what the console shows, and foxholewarbot-verbose.<date>.log, which also holds
# everything serenity, poise, reqwest and sqlx say. Empty turns file logging off
# and leaves the console alone. In docker-compose this is /app/logs, mounted.
LOG_DIR="./logs"
# Days of log files kept; 0 keeps everything.
LOG_RETENTION_DAYS=14
# Filter overrides, in RUST_LOG syntax. Unset means the defaults, which are a
# console carrying this crate at info and everything else at warn, and a verbose
# file carrying everything at debug. Raise the console when you want the HTTP
# traffic in front of you: RUST_LOG=info
RUST_LOG=
LOG_FILE_FILTER=
LOG_VERBOSE_FILTER=

# Postgres (see specs/postgres.md)
# App connection string:
DATABASE_URL="postgres://foxhole:changeme@localhost:5432/foxholewarbot"
# Used by the docker-compose `db` service:
POSTGRES_PASSWORD="changeme"
