# Discord
TOKEN=""
APP_ID=
GUILD_ID=
# Support-server channel for full-map schedule requests (optional; see
# specs/active/premium-full-map.md). Unset => command-only review.
REQUESTS_CHANNEL_ID=
# Extra people allowed to approve/deny those requests, on top of the app's owner
# and team. Comma-separated Discord user ids, e.g. 123456789,987654321.
# Here rather than in the database on purpose: reviewers read other servers'
# form answers, so the list belongs to whoever runs the host.
REVIEWER_IDS=

# Postgres (see specs/active/postgres-migration.md)
# App connection string:
DATABASE_URL="postgres://foxhole:changeme@localhost:5432/foxholewarbot"
# Used by the docker-compose `db` service:
POSTGRES_PASSWORD="changeme"
